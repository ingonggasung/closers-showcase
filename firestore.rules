rules_version = '2';

// Paste this whole file into Firebase Console -> Firestore Database -> 규칙.
// It replaces the existing ruleset entirely.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() && request.auth.token.email == 'tnals1870@gmail.com';
    }

    // Reads defensively: a users doc that exists but has never been
    // blocked simply has no `blocked` key, and reading a missing key in
    // rules raises, which would deny the whole write.
    function isBlocked() {
      return isSignedIn()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid))
             .data.keys().hasAny(['blocked'])
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.blocked == true;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Base character roster - admin curates it, everyone can see it.
    match /characters/{characterId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Costume posts.
    match /slots/{slotId} {
      allow read: if true;

      allow create: if isAdmin()
        || (isSignedIn()
        && !isBlocked()
        && request.resource.data.ownerId == request.auth.uid
        // A new post is never born already verified - only the admin's
        // ruling (below) may set this. Absent is fine too, so a client
        // predating the field still posts instead of erroring out.
        && (!request.resource.data.keys().hasAny(['verifiedCapture'])
            || request.resource.data.verifiedCapture == null));

      allow update: if isAdmin()
        || (isSignedIn()
            && !isBlocked()
            && resource.data.ownerId == request.auth.uid
            // Owners may edit their own post, but not its capture ruling
            // or who owns it.
            // The owner's client writes its own auto-review verdict right
            // after posting, so those fields are allowed here - but the
            // admin's ruling fields never are.
            && !changedKeys().hasAny(['verifiedCapture', 'verifiedAt', 'ownerId']));

      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.ownerId == request.auth.uid);
    }

    // Scraps - private to the user who made them. Doc id is `${uid}_${slotId}`.
    match /scraps/{scrapId} {
      allow read, delete: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && request.resource.data.userId == request.auth.uid;
    }

    // Reports - anyone signed in can file one; only the admin reads or clears them.
    match /reports/{reportId} {
      allow read, delete: if isAdmin();
      allow create: if isSignedIn() && request.resource.data.reporterId == request.auth.uid;
      allow update: if false;
    }

    // Labelled training examples - admin's own working set, nobody else's
    // business to read or write.
    match /trainingSamples/{sampleId} {
      allow read, write: if isAdmin();
    }

    // Archive of auto-deleted posts, so a classifier mistake is recoverable.
    match /autoDeleted/{docId} {
      allow read, write: if isAdmin();
    }

    // Auto-moderation switch. Everyone reads it (their client needs to know
    // whether the trial is on); only the admin flips it.
    match /config/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // User profiles. Public to read (nicknames/avatars show on posts), but a
    // user may only set their own display fields - warningCount and blocked
    // are the admin's alone, which is what makes account blocking
    // admin-only end to end.
    match /users/{userId} {
      allow read: if true;
      allow write: if isAdmin();
      allow create: if isSignedIn()
        && request.auth.uid == userId
        && request.resource.data.keys().hasOnly(['photoURL', 'nickname', 'updatedAt']);
      allow update: if isSignedIn()
        && request.auth.uid == userId
        && changedKeys().hasOnly(['photoURL', 'nickname', 'updatedAt']);
    }
  }
}
